# Copy to `.env` in the repo root. Both apps read it in development.
# Never commit real secrets. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ─── General ─────────────────────────────────────────────────────────────
NODE_ENV=development
# Public address users see (web + /api on one origin). Also used in email links.
SITE_URL=http://localhost:3500
# Extra origins allowed for mutating requests (comma-separated; www/non-www is added automatically).
ALLOWED_ORIGINS=
LOG_LEVEL=info

# ─── API ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4500
# How the web server reaches the API (server-side fetches).
INTERNAL_API_URL=http://localhost:4500
# Trust X-Forwarded-* from the reverse proxy (true behind Caddy/Nginx/cPanel).
TRUST_PROXY=false

# ─── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgres://ba:ba_dev_password@localhost:5434/ba_dev
DATABASE_URL_TEST=postgres://ba:ba_dev_password@localhost:5434/ba_test

# ─── First start ─────────────────────────────────────────────────────────
# true = create/update the database tables every time the app starts
AUTO_SETUP=false
# The first administrator, created on start ONLY while there is no administrator.
# Development creates admin / admin automatically when these are empty; production never does.
ADMIN_LOGIN=
ADMIN_PASSWORD=

# ─── Secrets ─────────────────────────────────────────────────────────────
# HMAC key for hashing IP addresses stored with sessions.
IP_HASH_SECRET=change-me-ip-hash-secret-at-least-32-chars

# ─── Email ───────────────────────────────────────────────────────────────
# console = print emails in the worker's terminal (development); smtp = really send them.
EMAIL_PROVIDER=console
EMAIL_FROM="Brand Ambassador <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Gmail: instead of SMTP_PASS use OAuth2 (npm run gmail-token prints the refresh token).
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=

# ─── Worker ──────────────────────────────────────────────────────────────
WORKER_POLL_MS=2000
RATE_LIMIT_ENABLED=true
