# Settings for shared hosting (cPanel "Setup Node.js App"). On the server, copy this file to `.env`
# in the application folder. Never upload your local .env.
#
# Fill in every line marked FILL IN. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"

NODE_ENV=production

# ─── Site ────────────────────────────────────────────────────────────────
# FILL IN: the public https address (switch on the free SSL in cPanel first)
SITE_URL=https://your-domain.bg
# Other addresses the site is opened from, comma-separated (www/non-www is added automatically)
ALLOWED_ORIGINS=
LOG_LEVEL=info
# The hosting's web server sits in front of the app
TRUST_PROXY=true

# ─── PostgreSQL (cPanel → PostgreSQL Databases) ──────────────────────────
# FILL IN: the database and user you created (the user needs ALL PRIVILEGES on the database).
# cPanel prefixes both names with your account name, e.g. myacct_ba / myacct_bauser.
# If the password has special characters (@ : / # ?), percent-encode them (@ -> %40).
DATABASE_URL=postgres://ACCOUNT_USER:PASSWORD@127.0.0.1:5432/ACCOUNT_DBNAME

# ─── First start ─────────────────────────────────────────────────────────
# true = create/update the database tables every time the app starts
AUTO_SETUP=true
# FILL IN: the first administrator, created on start ONLY while there is no administrator.
# Login: an email (it then also gets the admin notification emails) or a username.
# Password: 10 to 128 characters. Remove ADMIN_PASSWORD from this file after the first start.
ADMIN_LOGIN=
ADMIN_PASSWORD=

# ─── Secrets ─────────────────────────────────────────────────────────────
# FILL IN: 32+ characters (HMAC key for the IP addresses stored with sessions)
IP_HASH_SECRET=

# ─── Email ───────────────────────────────────────────────────────────────
# console writes emails into the cron log (jobs.log) instead of sending them.
# For real use set EMAIL_PROVIDER=smtp and fill in the SMTP lines
# (cPanel → Email Accounts → Connect Devices shows the host and port).
EMAIL_PROVIDER=console
EMAIL_FROM="Brand Ambassador <no-reply@your-domain.bg>"
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# ...or, instead of SMTP_PASS, OAuth2 (Gmail): get the refresh token once with npm run gmail-token.
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=

RATE_LIMIT_ENABLED=true
